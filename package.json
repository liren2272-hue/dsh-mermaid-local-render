{
  "name": "@local/dsh-mermaid",
  "version": "1.0.0",
  "icon": "./icon.svg",
  "private": true,
  "type": "module",
  "description": "Render ```mermaid fences in agent output as live SVG diagrams that follow the DSH light/dark theme.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "mermaid.min.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
